#!/bin/sh
#
# Block any commit that would put one customer into this product.
#
# This is a COMMERCIAL appliance. Every box ships to a different grower, and no
# grower's facility — its name, its buildings, its controller addresses, or its
# operating numbers — may appear in the product another grower runs. A guard
# test already checks this, but a test only runs when someone remembers to run
# it. A doc comment written at 3am does not remind anybody. This does.
#
# There are TWO guards here, because a customer leaks in two shapes:
#
#   1. IDENTITY  — names, building codes, hostnames, network addresses.
#   2. VALUES    — their operating thresholds and bands.
#
# Guard 2 was added 2026-08-27 after one facility's pH and EC band was found
# shipping across ten sites in this repo — including two raw-SQL clauses on the
# live reading path — while guard 1 reported clean the whole time. A
# confidentiality obligation names "processes", "formulae" and "test data", not
# only names. Stripping the name and shipping the number leaves behind the part
# the clause actually describes.
#
# Patterns are assembled from fragments so this file does not match itself.
#
# NOTE ON DIALECT: `git grep -E` and `grep -E` are POSIX ERE. `\b` is NOT a word
# boundary here and there is no lookahead — patterns written in JavaScript's
# dialect are silently inert. Every pattern below is bracket-expression based
# for that reason, and `--check` proves they still match.
#
# Install:  git config core.hooksPath .githooks
# Bypass:   git commit --no-verify   (do not, without a reason you would defend)

set -e

# ---- Guard 1: identity ----

B1="$(printf 'A%s' 'B')"
B2="$(printf 'E%s' 'F')"
B3="$(printf 'G%s' 'H')"
HOSTPART="$(printf 'anderson%s' '-hub')"
NETPART='10\.10\.[0-9]{1,3}\.[0-9]{1,3}'

CODEPART="(^|[^A-Za-z0-9_])($B1|$B2|$B3)[0-9-]*([^A-Za-z0-9_]|\$)"

# ---- Per-repo relaxation: building codes only ----
#
# 2026-08-29, Max's call, for THIS repo only. The System Map is deliberately
# public and already carries the building codes in 117 places across 25 nodes —
# identical 117 already on origin/main. Blocking them here does not remove one
# character from the internet; it only makes the map permanently un-editable,
# which is a worse outcome than the exposure it fails to undo.
#
# ⛔ SCOPE: this relaxes the building codes and NOTHING else. The hostname, the
# network addressing and the whole operating-value guard stay ON — the hostname
# and addressing were scrubbed from this repo the same day precisely because
# they were worth removing.
#
# Set per-clone with:  git config hark.allowBuildingCodes 1
# It lives in .git/config, which is NOT committed — so a fresh clone is strict
# again by default. That is deliberate: the relaxation is a decision someone
# has to make on purpose, not one that travels.
ALLOW_CODES="$(git config --get hark.allowBuildingCodes 2>/dev/null || true)"

if [ "$ALLOW_CODES" = "1" ]; then
  PATTERN="$HOSTPART|$NETPART"
  EXPECT=2
else
  PATTERN="$CODEPART|$HOSTPART|$NETPART"
  EXPECT=3
fi

# --check proves the patterns are live in the engine that runs them.
if [ "$1" = "--check" ]; then
  fails=0

  probe="$(printf 'zone %s1 x\nssh %s\nhost %s.%s.9.254\n' "$B1" "$HOSTPART" 10 10)"
  hits="$(printf '%s' "$probe" | grep -cE "$PATTERN" || true)"
  if [ "$hits" -lt "$EXPECT" ]; then
    echo "identity guard FAILED: matched $hits of $EXPECT known samples. It is inert."
    fails=1
  else
    echo "identity guard OK: $hits/$EXPECT known samples matched."
  fi

  # When the relaxation is on, PROVE it is the relaxation and not a broken
  # pattern. Without this, a typo that made the whole guard inert would report
  # exactly the same as a deliberate opt-out — which is the failure mode this
  # file exists to prevent.
  if [ "$ALLOW_CODES" = "1" ]; then
    cprobe="$(printf 'zone %s1 x\n' "$B1")"
    chits="$(printf '%s' "$cprobe" | grep -cE "$PATTERN" || true)"
    if [ "$chits" -ne 0 ]; then
      echo "relaxation FAILED: building codes still match despite hark.allowBuildingCodes=1."
      fails=1
    else
      echo "identity guard: building codes ALLOWED here on purpose (hark.allowBuildingCodes=1)."
      echo "                hostname + network still blocked; value guard untouched."
    fi
  fi

  # A pH/EC value must now PASS. The value guard was retired 2026-09-03 on Max's
  # ruling; this probe exists so a silent re-introduction fails the self-test.
  vprobe="$(printf 'phHigh: 6.3, phLow: 5.6,\ncomboEcHigh: 3.5,\n')"
  vblocked="$(printf '%s' "$vprobe" | grep -cE "$PATTERN" || true)"
  if [ "$vblocked" -ne 0 ]; then
    echo "FAILED: the guard is matching pH/EC values. It must not."
    fails=1
  else
    echo "values OK: pH/EC numbers pass, as ruled 2026-08-29."
  fi

  [ "$fails" -eq 0 ] || exit 1
  exit 0
fi

# Only added lines matter. Removing a reference must never be blocked.
COMMON_EXCLUDES="':!*.lock' ':!pnpm-lock.yaml' ':!.githooks/pre-commit'"

added="$(git diff --cached --unified=0 --diff-filter=ACMR -- \
          ':!*.lock' ':!pnpm-lock.yaml' ':!.githooks/pre-commit' \
        | grep '^+' | grep -v '^+++' || true)"

blocked=0

if [ -n "$added" ]; then
  found="$(printf '%s' "$added" | grep -nE "$PATTERN" || true)"
  if [ -n "$found" ]; then
    blocked=1
    echo ""
    echo "COMMIT BLOCKED — a customer's facility IDENTITY is in these added lines:"
    echo ""
    printf '%s\n' "$found" | sed 's/^/    /'
    echo ""
    echo "This product ships to growers who are not this customer. Their box must"
    echo "carry no trace of this one — not in code, not in tests, not in a comment."
    echo ""
    echo "A building code as a doc-comment example still counts. Use no example, or"
    echo "one that could not be mistaken for a real facility's."
    echo ""
  fi
fi

[ "$blocked" -eq 0 ] || exit 1
exit 0
